{
  "schemaVersion": 1,
  "id": "blockstager_fabric",
  "version": "1.0.0",
  "name": "Blockstager Studio Client",
  "description": "Mod cliente ligero para conectar Minecraft (Fabric 1.21+) con Blockstager Studio mediante el protocolo local blockstager.proto/1.2.",
  "authors": [
    "Blockstager Studio"
  ],
  "contact": {
    "homepage": "https://github.com/cgpc37/blockstager-minecraft-connectors",
    "sources": "https://github.com/cgpc37/blockstager-minecraft-connectors",
    "issues": "https://github.com/cgpc37/blockstager-minecraft-connectors/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.blockstager.fabric.BlockstagerFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21",
    "java": ">=21",
    "fabric-lifecycle-events-v1": "*"
  },
  "recommends": {
    "fabric-networking-api-v1": "*",
    "fabric-command-api-v2": "*"
  }
}
